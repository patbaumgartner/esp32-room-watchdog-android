* text=auto eol=lf

# Source and configuration files use Unix line endings.
*.gradle text eol=lf
*.kts text eol=lf
*.kt text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.pro text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows scripts remain native to Windows.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never be line-ending normalized.
*.aab binary
*.apk binary
*.avif binary
*.gif binary
*.ico binary
*.jar binary
*.jpeg binary
*.jpg binary
*.jks binary
*.keystore binary
*.png binary
*.ttf binary
*.webp binary
*.zip binary
