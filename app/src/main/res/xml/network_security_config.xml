<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext stays enabled for user-configured ESP32 devices on a trusted LAN/VPN.
     The Gotify server URL is separately required to be HTTPS in code. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>